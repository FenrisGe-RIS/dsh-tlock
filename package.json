    "T约束"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "author": {
    "name": "T约束"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FenrisGe-RIS/dsh-tlock.git"
  },
  "homepage": "https://github.com/FenrisGe-RIS/dsh-tlock#readme",
  "bugs": {
    "url": "https://github.com/FenrisGe-RIS/dsh-tlock/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
